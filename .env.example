# DNS Options Scanner - API Credentials
# Copy this file to .env and add your Dhan credentials

DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_CLIENT_ID=your_client_id_here
# Optional: stock underlyings map for stock options fetch/scanner
# Example:
# DHAN_UNDERLYING_MAP_JSON={"RELIANCE":{"security_id":2885,"instrument":"OPTSTK"},"SBIN":{"security_id":3045,"instrument":"OPTSTK"}}

# Optional: market holiday list for next-working-day resolution
# Example:
# MARKET_HOLIDAYS_JSON=["2026-03-30","2026-11-13"]

